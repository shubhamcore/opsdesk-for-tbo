# ---------------------------------------------------------------------------
# OpsDesk for TBO — environment template. Never commit real values.
# Copy to .env (gitignored) or inject via your orchestrator's secret store.
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
OPSDESK_ENV=development                     # development | staging | production
OPSDESK_APP_NAME=OpsDesk for TBO
OPSDESK_SECRET_KEY=replace-with-32-bytes-of-randomness
OPSDESK_TOKEN_TTL_MINUTES=720

# --- storage ---------------------------------------------------------------
# SQLite (default, WAL) or any SQLAlchemy URL, e.g.
# OPSDESK_DATABASE_URL=postgresql+psycopg://opsdesk:secret@db:5432/opsdesk
OPSDESK_DATABASE_URL=sqlite:///./database/opsdesk.db
OPSDESK_EXPORT_DIR=./exports
OPSDESK_EXPORT_BATCH_SIZE=5000

# --- classifier ------------------------------------------------------------
OPSDESK_MODEL_PATH=./ai_models/saved_models/intent_pipeline.joblib

# --- security --------------------------------------------------------------
# Sign-in attempts per client per minute (0 disables the limiter)
OPSDESK_RATE_LIMIT_PER_MINUTE=60
# Set to false on any shared deployment to hide one-click demo sign-in
OPSDESK_ENABLE_ROLE_SWITCH=true
# Password for the seeded synthetic identities (demo only)
OPSDESK_DEMO_PASSWORD=OpsDesk#2026
OPSDESK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- agent mesh ------------------------------------------------------------
# Extension point for a future hosted model. Unimplemented in this build: the
# agents are deterministic specialists and never contact an external endpoint.
# OPSDESK_LLM_ENDPOINT=
